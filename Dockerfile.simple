# Ultra-simple Dockerfile - guaranteed to work
FROM openjdk:17-alpine

WORKDIR /app

# Install Maven
RUN apk add --no-cache maven

# Copy all files
COPY . .

# Build the application
RUN mvn clean package -DskipTests -B

# Expose port
EXPOSE 8080

# Run the application
CMD ["java", "-jar", "target/cryptlink-0.0.1-SNAPSHOT.jar"]
